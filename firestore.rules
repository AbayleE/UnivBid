rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function validPrice(price) {
      return price is number && price > 0 && price <= 9999999.99;
    }

    // TRANSITIONAL: the client still writes quantity as a string such as "3".
    function validQuantity(quantity) {
      return (quantity is int && quantity > 0)
        || (quantity is string && quantity.matches('[1-9][0-9]{0,5}'));
    }

    // Fields a seller controls. Applied to both create and update.
    function validListing(data) {
      return data.name is string
        && data.name.size() > 0
        && data.name.size() <= 120
        && data.description is string
        && data.description.size() <= 2000
        && validPrice(data.price)
        && validQuantity(data.product_quantity)
        && data.condition in ['New', 'Like New', 'Fairly Good', 'Used', 'Heavily Used']
        && data.image is string
        && data.image.size() <= 2048
        && data.get('categories', '') is string
        && data.get('categories', '').size() <= 64
        && data.get('auction_deadline', '') is string
        && data.get('auction_deadline', '').size() <= 32;
    }

    // Profiles hold email and phone, so only the owner can read them.
    // sellerStripeAccountId decides where payouts go, so only the server
    // (Admin SDK, which bypasses these rules) may set it.
    match /users/{uid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;

      allow create: if signedIn()
        && request.auth.uid == uid
        && !('sellerStripeAccountId' in request.resource.data);

      allow update: if signedIn()
        && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['sellerStripeAccountId']);
    }

    match /products/{pid} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.keys().hasAll([
             'pid', 'status', 'soldBy', 'soldBy_name', 'dateListed', 'name',
             'description', 'price', 'condition', 'image', 'product_quantity'])
        && request.resource.data.keys().hasOnly([
             'pid', 'status', 'soldBy', 'soldBy_name', 'dateListed', 'name',
             'description', 'price', 'condition', 'image', 'product_quantity',
             'categories', 'auction_deadline'])
        && request.resource.data.pid == pid
        && request.resource.data.soldBy == request.auth.uid
        && request.resource.data.status == 'Available'
        && request.resource.data.soldBy_name is string
        && request.resource.data.soldBy_name.size() <= 120
        && request.resource.data.dateListed is timestamp
        && validListing(request.resource.data);

      // soldBy, status, pid, soldBy_name and dateListed cannot change here.
      allow update: if signedIn()
        && resource.data.soldBy == request.auth.uid
        && resource.data.status == 'Available'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'name', 'description', 'price', 'condition', 'image',
             'product_quantity', 'categories', 'auction_deadline'])
        && validListing(request.resource.data);

      allow delete: if signedIn() && resource.data.soldBy == request.auth.uid;
    }

    // Orders are written only by the Stripe webhook (Admin SDK).
    match /orders/{orderId} {
      allow read: if signedIn()
        && (resource.data.sellerUid == request.auth.uid
            || resource.data.buyerUid == request.auth.uid);
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
